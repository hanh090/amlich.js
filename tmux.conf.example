# Example tmux configuration for Vietnamese Lunar Calendar
# Add this to your ~/.tmux.conf file

# Display lunar calendar in the right side of status bar
set -g status-right "#(/path/to/amlich.js/bin/tmux-lunar-date) | %H:%M %d-%b-%y"

# Refresh status bar every 60 seconds
set -g status-interval 60

# Optional: Customize status bar colors
set -g status-style bg=black,fg=white
set -g status-right-style bg=black,fg=green

# Alternative: Display only lunar date
# set -g status-right "#(/path/to/amlich.js/bin/tmux-lunar-date)"

# Alternative: Display with custom time format
# set -g status-right "#(/path/to/amlich.js/bin/tmux-lunar-date) | %A, %d %B %Y %H:%M"
